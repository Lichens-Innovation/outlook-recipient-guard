<?xml version="1.0" encoding="UTF-8"?>
<!--
  Recipient Guard — XML manifest for Outlook (sideload via "Add a custom add-in → Add from File").
  Replace https://lichens-innovation.github.io/outlook-recipient-guard with the HTTPS URL where the files are hosted
  (or run ./set-base-url.sh).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>578a46a9-b884-4957-bd09-878649977dda</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>amwebexpert</ProviderName>
  <DefaultLocale>fr-CA</DefaultLocale>
  <DisplayName DefaultValue="Recipient Guard"/>
  <Description DefaultValue="Alerte avant l'envoi si un destinataire correspond à une liste d'adresses à surveiller."/>
  <IconUrl DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/"/>
  <AppDomains>
    <AppDomain>https://lichens-innovation.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- HTML for Outlook on the web / new Outlook / Mac; JS only for classic Outlook on Windows -->
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>

            <!-- Compose ribbon button that opens the configuration task pane -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="rgGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="rgOpenPane">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Smart Alerts: intercepts send -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="PromptUser"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/taskpane.html"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://lichens-innovation.github.io/outlook-recipient-guard/launchevent.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Recipient Guard"/>
          <bt:String id="Button.Label" DefaultValue="Destinataires surveillés"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Configurer la liste des adresses qui déclenchent une alerte avant l'envoi."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
